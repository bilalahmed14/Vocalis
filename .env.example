# Copy to .env and fill in the providers you use.
# Agent configs never contain keys; the runtime reads them from here.

# STT
DEEPGRAM_API_KEY=

# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# TTS
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# Where saved agents live. The Docker stack sets this itself; this value is for
# running the API or the tests against a database you started yourself.
DATABASE_URL=postgresql://vocalis:vocalis@localhost:5432/vocalis

# Live metrics pub/sub (Phase 3)
REDIS_URL=redis://localhost:6379/0
