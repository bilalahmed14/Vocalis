{
  "$schema": "../../../schema/provider.v1.schema.json",
  "id": "cartesia",
  "type": "tts",
  "name": "Cartesia",
  "description": "Low-latency streaming text to speech with Sonic models.",
  "docs_url": "https://docs.cartesia.ai/build-with-cartesia/models",
  "env": ["CARTESIA_API_KEY"],
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": ["voice_id"],
    "properties": {
      "voice_id": {
        "title": "Voice ID",
        "description": "Copy it from the Cartesia voice library.",
        "type": "string",
        "minLength": 1,
        "examples": ["71a7ad14-091c-4e8e-a314-022ece01c121"]
      },
      "model": {
        "title": "Model",
        "type": "string",
        "default": "sonic-3",
        "examples": ["sonic-3", "sonic-2"]
      },
      "language": {
        "title": "Language",
        "type": "string",
        "default": "en"
      }
    }
  }
}
